# Campus-to-Hire Environment Variables
# Copy this file to .env and fill in your actual values

# =============================================================================
# Database Configuration (Neon PostgreSQL)
# =============================================================================
# Format: postgresql://user:password@host:port/database
# For async: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/campus_to_hire

# =============================================================================
# JWT Authentication
# =============================================================================
# Generate a secure random string for JWT_SECRET
# You can use: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256

# =============================================================================
# AWS Configuration (for Bedrock AI)
# =============================================================================
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# =============================================================================
# Amazon Bedrock Model Configuration
# =============================================================================
# Default: Claude 3 Haiku for cost-effective responses
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Other options:
# BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
# BEDROCK_MODEL_ID=anthropic.claude-3-opus-20240229-v1:0

# =============================================================================
# CORS Configuration
# =============================================================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://yourdomain.com

# =============================================================================
# Optional: API Configuration
# =============================================================================
# API_PREFIX=/api
